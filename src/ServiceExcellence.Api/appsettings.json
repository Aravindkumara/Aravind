{
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=service_excellence;Username=sopapp;Password=sopapp_pwd"
  },
  "Jwt": {
    "Issuer": "ServiceExcellence.Api",
    "Audience": "ServiceExcellence.Web",
    "Key": "CHANGE-ME-this-is-a-development-only-signing-key-0123456789",
    "ExpiryMinutes": 480
  },
  "Storage": {
    "UploadPath": "uploads",
    "MaxFileSizeBytes": 10485760
  },
  "Swagger": {
    "Enabled": true
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "System.Net.Http": "Warning",
        "Microsoft.AspNetCore.Diagnostics.ExceptionHandlerMiddleware": "Fatal"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/api-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
