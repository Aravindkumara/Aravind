@model DashboardDto
@{
    ViewData["Title"] = "Dashboard";
    var isInternal = User.IsInternal();
    var totalSops = Model.SopsByStatus.Values.Sum();
    int Count(string status) => Model.SopsByStatus.TryGetValue(status, out var n) ? n : 0;
}
<div class="page-header">
    <h1>Welcome, @User.GetFullName()</h1>
    <div class="d-flex gap-2">
        <a asp-controller="Finder" asp-action="Index" class="btn btn-outline-primary">Find SOPs for a vehicle</a>
        @if (User.IsInRole(Roles.Admin) || User.IsInRole(Roles.Author))
        {
            <a asp-controller="Sops" asp-action="Create" class="btn btn-primary">New SOP</a>
        }
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <div class="card stat-card h-100"><div class="card-body">
            <div class="stat-value">@Count(SopStatus.Published)</div>
            <div class="stat-label">Published SOPs</div>
        </div></div>
    </div>
    @if (isInternal)
    {
        <div class="col-6 col-lg-3">
            <a class="text-decoration-none" asp-controller="Sops" asp-action="Index" asp-route-status="@SopStatus.UnderReview">
                <div class="card stat-card h-100"><div class="card-body">
                    <div class="stat-value">@Count(SopStatus.UnderReview)</div>
                    <div class="stat-label">Awaiting review</div>
                </div></div>
            </a>
        </div>
        <div class="col-6 col-lg-3">
            <a class="text-decoration-none" asp-controller="Sops" asp-action="Index" asp-route-status="@SopStatus.Draft">
                <div class="card stat-card h-100"><div class="card-body">
                    <div class="stat-value">@(Count(SopStatus.Draft) + Count(SopStatus.Rejected))</div>
                    <div class="stat-label">Drafts &amp; rejected</div>
                </div></div>
            </a>
        </div>
    }
    <div class="col-6 col-lg-3">
        <div class="card stat-card h-100"><div class="card-body">
            <div class="stat-value">@Model.Variants</div>
            <div class="stat-label">Active variants across @Model.Models models &amp; @Model.Divisions divisions</div>
        </div></div>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-8">
        <div class="card h-100">
            <div class="card-header d-flex justify-content-between">
                <span>@(isInternal ? "Recently updated SOPs" : "Recently published SOPs")</span>
                <a asp-controller="Sops" asp-action="Index" class="small fw-normal">View all</a>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead><tr><th>SOP</th><th>Applies to</th><th>Status</th><th>Updated</th></tr></thead>
                    <tbody>
                    @foreach (var s in Model.RecentSops)
                    {
                        <tr>
                            <td>
                                <a asp-controller="Sops" asp-action="Details" asp-route-id="@s.Id" class="fw-semibold">@s.SopCode</a>
                                <span class="text-muted small">v@(s.Version)</span>
                                <div class="small">@s.Title</div>
                            </td>
                            <td class="small"><span class="text-muted">@s.AppliesToLevel:</span> @s.AppliesTo</td>
                            <td><partial name="_StatusBadge" model="s.Status" /></td>
                            <td class="small text-nowrap">@Ui.Date(s.UpdatedAt ?? s.CreatedAt)</td>
                        </tr>
                    }
                    @if (Model.RecentSops.Count == 0)
                    {
                        <tr><td colspan="4" class="text-center text-muted py-4">No SOPs yet.</td></tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card mb-3">
            <div class="card-header">Published SOPs by service activity</div>
            <ul class="list-group list-group-flush">
                @foreach (var (code, name) in ActivityTypes.All)
                {
                    var n = Model.PublishedByActivity.TryGetValue(code, out var c) ? c : 0;
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <a asp-controller="Sops" asp-action="Index" asp-route-activityType="@code" class="text-decoration-none text-body">@name</a>
                        <span class="badge rounded-pill bg-secondary">@n</span>
                    </li>
                }
            </ul>
        </div>
        @if (isInternal)
        {
            <div class="card">
                <div class="card-header">SOPs by status</div>
                <div class="card-body">
                    @foreach (var status in SopStatus.All)
                    {
                        var n = Count(status);
                        var pct = totalSops == 0 ? 0 : n * 100 / totalSops;
                        <div class="d-flex justify-content-between small"><span>@SopStatus.Display(status)</span><span>@n</span></div>
                        <div class="progress mb-2" style="height: 6px;" role="progressbar" aria-label="@SopStatus.Display(status)" aria-valuenow="@pct" aria-valuemin="0" aria-valuemax="100">
                            <div class="progress-bar @Ui.StatusBadge(status).Split(' ')[0]" style="width: @pct%"></div>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</div>
