@model ListViewModel<DealerDto, PagedQuery>
@{ ViewData["Title"] = "Dealers"; ViewData["Pretitle"] = "Administration"; }
@section PageActions { <a asp-action="Create" class="btn btn-primary"><i class="ti ti-plus me-1"></i>Add dealer</a> }
<div class="card">
    <div class="card-body border-bottom py-3">
        <form method="get" class="row g-2 align-items-end filter-row">
            <div class="col-md-5">
                <label class="form-label" for="search">Search</label>
                <div class="input-icon">
                    <span class="input-icon-addon"><i class="ti ti-search"></i></span>
                    <input id="search" name="search" value="@Model.Query.Search" class="form-control" placeholder="Code, name, city or state" />
                </div>
            </div>
            <div class="col-md-auto d-flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="ti ti-filter me-1"></i>Filter</button>
                <a asp-action="Index" class="btn btn-ghost-secondary">Reset</a>
            </div>
        </form>
    </div>
    @if (Model.Result.TotalCount == 0)
    {
        <div class="card-body"><partial name="_Empty" model="@(("ti-building-store", "No dealers found", "Try a different search or add a dealer."))" /></div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table card-table table-vcenter">
                <thead>
                    <tr>
                        <th><partial name="_SortHeader" model="@(("Dealer", "name"))" /></th>
                        <th><partial name="_SortHeader" model="@(("Code", "code"))" /></th>
                        <th><partial name="_SortHeader" model="@(("Location", "city"))" /></th>
                        <th>Contact</th>
                        <th><partial name="_SortHeader" model="@(("Status", "isActive"))" /></th>
                        <th class="w-1"></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var d in Model.Result.Items)
                {
                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <span class="avatar avatar-sm bg-teal-lt"><i class="ti ti-building-store"></i></span>
                                <span class="fw-medium">@d.Name</span>
                            </div>
                        </td>
                        <td><span class="badge bg-secondary-lt font-monospace">@d.Code</span></td>
                        <td class="text-secondary"><i class="ti ti-map-pin me-1"></i>@d.City@(string.IsNullOrEmpty(d.State) ? "" : ", " + d.State)</td>
                        <td class="small">
                            @if (!string.IsNullOrEmpty(d.ContactPhone)) { <div><i class="ti ti-phone me-1 text-secondary"></i>@d.ContactPhone</div> }
                            @if (!string.IsNullOrEmpty(d.Email)) { <div><i class="ti ti-mail me-1 text-secondary"></i>@d.Email</div> }
                        </td>
                        <td><partial name="_ActiveBadge" model="d.IsActive" /></td>
                        <td><a asp-action="Edit" asp-route-id="@d.Id" class="btn btn-sm btn-icon btn-ghost-primary" title="Edit" aria-label="Edit @d.Name"><i class="ti ti-edit"></i></a></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
        <partial name="_Pager" model="PagerModel.From(Model.Result)" />
    }
</div>
