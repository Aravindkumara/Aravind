<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Service Excellence</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @{
        var isAdmin = User.IsInRole(Roles.Admin);
        var isInternal = User.IsInternal();
        var controller = ViewContext.RouteData.Values["controller"]?.ToString();
        string Active(params string[] names) => names.Contains(controller, StringComparer.OrdinalIgnoreCase) ? "active" : "";
    }
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark app-navbar">
            <div class="container-fluid">
                <a class="navbar-brand fw-semibold" asp-controller="Home" asp-action="Index">
                    <span class="brand-mark">SE</span> Service Excellence
                </a>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="collapse navbar-collapse" id="mainNav">
                        <ul class="navbar-nav me-auto">
                            <li class="nav-item"><a class="nav-link @Active("Home")" asp-controller="Home" asp-action="Index">Dashboard</a></li>
                            <li class="nav-item"><a class="nav-link @Active("Finder")" asp-controller="Finder" asp-action="Index">SOP Finder</a></li>
                            <li class="nav-item"><a class="nav-link @Active("Sops")" asp-controller="Sops" asp-action="Index">@(isInternal ? "SOPs" : "SOP Library")</a></li>
                            @if (isInternal)
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle @Active("Masters", "Assemblies")" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">Product Hierarchy</a>
                                    <ul class="dropdown-menu">
                                        @foreach (var type in Enum.GetValues<MasterType>())
                                        {
                                            <li><a class="dropdown-item" asp-controller="Masters" asp-action="Index" asp-route-type="@type">@MasterTypes.DisplayPlural(type)</a></li>
                                        }
                                        <li><a class="dropdown-item" asp-controller="Assemblies" asp-action="Index">Assemblies</a></li>
                                    </ul>
                                </li>
                            }
                            @if (isAdmin)
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle @Active("Dealers", "Users", "Audit")" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">Administration</a>
                                    <ul class="dropdown-menu">
                                        <li><a class="dropdown-item" asp-controller="Dealers" asp-action="Index">Dealers</a></li>
                                        <li><a class="dropdown-item" asp-controller="Users" asp-action="Index">Users</a></li>
                                        <li><a class="dropdown-item" asp-controller="Audit" asp-action="Index">Audit Trail</a></li>
                                    </ul>
                                </li>
                            }
                        </ul>
                        <ul class="navbar-nav">
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    @User.GetFullName() <span class="badge rounded-pill bg-light text-dark ms-1">@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value</span>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li><a class="dropdown-item" asp-controller="Account" asp-action="ChangePassword">Change password</a></li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post">
                                            <button type="submit" class="dropdown-item">Sign out</button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        </ul>
                    </div>
                }
            </div>
        </nav>
    </header>

    <main class="container-xl py-4">
        <partial name="_Alerts" />
        @RenderBody()
    </main>

    <footer class="border-top py-3 text-muted small">
        <div class="container-xl">OEM Product Service Excellence &middot; Standard operating procedures for dealer service</div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
