@model ServiceExcellence.Web.ViewModels.PagerModel
@if (Model.TotalCount > 0)
{
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mt-3">
        <div class="text-muted small">
            Showing @((Model.Page - 1) * Model.PageSize + 1)–@Math.Min(Model.Page * Model.PageSize, Model.TotalCount) of @Model.TotalCount
        </div>
        @if (Model.TotalPages > 1)
        {
            var start = Math.Max(1, Model.Page - 2);
            var end = Math.Min(Model.TotalPages, start + 4);
            start = Math.Max(1, end - 4);
            <nav aria-label="Pagination">
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(Model.Page <= 1 ? "disabled" : "")"><a class="page-link" href="@Url.PageUrl(Model.Page - 1)">Previous</a></li>
                    @for (var p = start; p <= end; p++)
                    {
                        <li class="page-item @(p == Model.Page ? "active" : "")"><a class="page-link" href="@Url.PageUrl(p)">@p</a></li>
                    }
                    <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")"><a class="page-link" href="@Url.PageUrl(Model.Page + 1)">Next</a></li>
                </ul>
            </nav>
        }
    </div>
}
else
{
    <div class="text-center text-muted py-4">No records found.</div>
}
