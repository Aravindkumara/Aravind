@model ListViewModel<UserDto, UserQuery>
@{ ViewData["Title"] = "Users"; }
<div class="page-header">
    <h1>Users</h1>
    <a asp-action="Create" class="btn btn-primary">Add user</a>
</div>
<form method="get" class="filter-bar row g-2 align-items-end">
    <div class="col-md-4">
        <label class="form-label small mb-1" for="search">Search</label>
        <input id="search" name="search" value="@Model.Query.Search" class="form-control" placeholder="Username, name, email or dealer" />
    </div>
    <div class="col-md-3">
        <label class="form-label small mb-1" for="role">Role</label>
        <select id="role" name="role" class="form-select">
            <option value="">All roles</option>
            @foreach (var r in Roles.All)
            {
                <option value="@r" selected="@(r == Model.Query.Role)">@r</option>
            }
        </select>
    </div>
    <div class="col-md-3 d-flex gap-2">
        <button type="submit" class="btn btn-primary">Filter</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Reset</a>
    </div>
</form>
<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th><partial name="_SortHeader" model="@(("Username", "username"))" /></th>
                    <th><partial name="_SortHeader" model="@(("Full name", "fullName"))" /></th>
                    <th><partial name="_SortHeader" model="@(("Role", "role"))" /></th>
                    <th><partial name="_SortHeader" model="@(("Dealer", "dealer"))" /></th>
                    <th><partial name="_SortHeader" model="@(("Last login", "lastLogin"))" /></th>
                    <th><partial name="_SortHeader" model="@(("Status", "isActive"))" /></th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var u in Model.Result.Items)
            {
                <tr>
                    <td class="fw-semibold">@u.Username</td>
                    <td>@u.FullName<div class="small text-muted">@u.Email</div></td>
                    <td>@u.Role</td>
                    <td class="small">@u.DealerName</td>
                    <td class="small">@Ui.DateTime(u.LastLoginAt)</td>
                    <td>@if (u.IsActive) { <span class="badge bg-success">Active</span> } else { <span class="badge bg-secondary">Inactive</span> }</td>
                    <td class="text-end"><a asp-action="Edit" asp-route-id="@u.Id" class="btn btn-sm btn-outline-primary">Edit</a></td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
<partial name="_Pager" model="PagerModel.From(Model.Result)" />
