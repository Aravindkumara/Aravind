@model UserFormViewModel
@{
    ViewData["Title"] = Model.Id.HasValue ? "Edit user" : "Add user";
    ViewData["Pretitle"] = "Users";
    var roles = new (string Role, string Icon, string Description)[]
    {
        (Roles.Admin, "ti-shield-lock", "Users, dealers, masters & audit"),
        (Roles.Author, "ti-pencil", "Writes and submits SOPs"),
        (Roles.Approver, "ti-circle-check", "Reviews and publishes SOPs"),
        (Roles.Dealer, "ti-building-store", "Reads published SOPs")
    };
}
<div class="row justify-content-center">
    <div class="col-lg-9 col-xl-8">
        <form method="post" class="card">
            <div class="card-body">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                <div class="form-section-title mb-2">Account</div>
                <div class="row">
                    <div class="col-md-5 mb-3">
                        <label asp-for="Item.Username" class="form-label required"></label>
                        <input asp-for="Item.Username" class="form-control" autocomplete="off" />
                        <span asp-validation-for="Item.Username"></span>
                    </div>
                    <div class="col-md-7 mb-3">
                        <label asp-for="Item.FullName" class="form-label required"></label>
                        <input asp-for="Item.FullName" class="form-control" />
                        <span asp-validation-for="Item.FullName"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="Item.Email" class="form-label"></label>
                        <input asp-for="Item.Email" class="form-control" />
                        <span asp-validation-for="Item.Email"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="Item.Password" class="form-label @(Model.Id.HasValue ? "" : "required")">@(Model.Id.HasValue ? "Reset password" : "Password")</label>
                        <input asp-for="Item.Password" class="form-control" autocomplete="new-password" />
                        <small class="form-hint">@(Model.Id.HasValue ? "Leave blank to keep the current password." : "At least 8 characters.")</small>
                        <span asp-validation-for="Item.Password"></span>
                    </div>
                </div>

                <div class="form-section-title mb-2 mt-2">Role</div>
                <div class="form-selectgroup form-selectgroup-boxes d-flex flex-column flex-md-row mb-1">
                    @foreach (var r in roles)
                    {
                        <label class="form-selectgroup-item flex-fill">
                            <input type="radio" name="Item.Role" value="@r.Role" class="form-selectgroup-input" checked="@(Model.Item.Role == r.Role)" data-role-radio />
                            <div class="form-selectgroup-label d-flex align-items-center p-3">
                                <div class="me-3"><span class="form-selectgroup-check"></span></div>
                                <div class="text-start">
                                    <div class="fw-medium"><i class="ti @r.Icon me-1"></i>@r.Role</div>
                                    <div class="small text-secondary">@r.Description</div>
                                </div>
                            </div>
                        </label>
                    }
                </div>
                <span asp-validation-for="Item.Role"></span>

                <div class="mt-3" id="dealerGroup">
                    <label asp-for="Item.DealerId" class="form-label required"></label>
                    <select asp-for="Item.DealerId" class="form-select">
                        <option value="">Select dealer…</option>
                        @foreach (var d in Model.Dealers)
                        {
                            <option value="@d.Id">@d.Name (@d.Code)</option>
                        }
                    </select>
                    <span asp-validation-for="Item.DealerId"></span>
                </div>

                <label class="form-check form-switch mt-3">
                    <input asp-for="Item.IsActive" class="form-check-input" />
                    <span class="form-check-label">Active</span>
                    <span class="form-check-description">Inactive users cannot sign in.</span>
                </label>
            </div>
            <div class="card-footer text-end">
                <a asp-action="Index" class="btn btn-link">Cancel</a>
                <button type="submit" class="btn btn-primary"><i class="ti ti-device-floppy me-1"></i>Save</button>
            </div>
        </form>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            var group = document.getElementById('dealerGroup');
            function toggle() {
                var checked = document.querySelector('[data-role-radio]:checked');
                group.style.display = checked && checked.value === '@Roles.Dealer' ? '' : 'none';
            }
            document.querySelectorAll('[data-role-radio]').forEach(function (r) { r.addEventListener('change', toggle); });
            toggle();
        })();
    </script>
}
