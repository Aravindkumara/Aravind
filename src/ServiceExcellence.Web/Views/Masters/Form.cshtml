@model MasterFormViewModel
@{
    var label = MasterTypes.Display(Model.Type);
    ViewData["Title"] = (Model.Id.HasValue ? "Edit " : "Add ") + label.ToLowerInvariant();
    var parentType = MasterTypes.Parent(Model.Type);
}
<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card">
            <div class="card-header">@ViewData["Title"]</div>
            <div class="card-body">
                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>
                    @if (parentType is { } pt)
                    {
                        <div class="mb-3">
                            <label asp-for="Item.ParentId" class="form-label">@MasterTypes.Display(pt)</label>
                            <select asp-for="Item.ParentId" class="form-select" required>
                                <option value="">-- Select @MasterTypes.Display(pt).ToLowerInvariant() --</option>
                                @foreach (var p in Model.Parents)
                                {
                                    <option value="@p.Id">@p.Text</option>
                                }
                            </select>
                            <span asp-validation-for="Item.ParentId"></span>
                        </div>
                    }
                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label asp-for="Item.Code" class="form-label"></label>
                            <input asp-for="Item.Code" class="form-control text-uppercase" />
                            <span asp-validation-for="Item.Code"></span>
                        </div>
                        <div class="col-md-8 mb-3">
                            <label asp-for="Item.Name" class="form-label"></label>
                            <input asp-for="Item.Name" class="form-control" />
                            <span asp-validation-for="Item.Name"></span>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Item.Description" class="form-label"></label>
                        <textarea asp-for="Item.Description" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="Item.Description"></span>
                    </div>
                    <div class="form-check mb-4">
                        <input asp-for="Item.IsActive" class="form-check-input" />
                        <label asp-for="Item.IsActive" class="form-check-label"></label>
                        <div class="form-text">Inactive items are hidden from drop-downs but existing SOPs keep them.</div>
                    </div>
                    <button type="submit" class="btn btn-primary">Save</button>
                    <a asp-action="Index" asp-route-type="@Model.Type" class="btn btn-link">Cancel</a>
                </form>
            </div>
        </div>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
