@model MasterIndexViewModel
@{
    ViewData["Title"] = MasterTypes.DisplayPlural(Model.Type);
    ViewData["Pretitle"] = "Product hierarchy";
    var parentType = MasterTypes.Parent(Model.Type);
    var isAdmin = User.IsInRole(Roles.Admin);
    var icon = Model.Type switch { MasterType.Division => "ti-building-factory-2", MasterType.Category => "ti-category", MasterType.Model => "ti-car", _ => "ti-versions" };
    var levels = Enum.GetValues<MasterType>();
}
@section PageActions {
    @if (isAdmin)
    {
        <a asp-action="Create" asp-route-type="@Model.Type" asp-route-parentId="@Model.Query.ParentId" class="btn btn-primary">
            <i class="ti ti-plus me-1"></i>Add @MasterTypes.Display(Model.Type).ToLowerInvariant()
        </a>
    }
}

<ul class="steps steps-blue mb-4 d-none d-md-flex" aria-label="Hierarchy levels">
    @foreach (var level in levels)
    {
        <li class="step-item @(level == Model.Type ? "active" : "")">
            <a asp-action="Index" asp-route-type="@level" class="text-reset">@MasterTypes.DisplayPlural(level)</a>
        </li>
    }
    <li class="step-item"><a asp-controller="Assemblies" asp-action="Index" class="text-reset">Assemblies</a></li>
</ul>

<div class="card">
    <div class="card-header">
        <div>
            <h3 class="card-title"><i class="ti @icon me-2 text-primary"></i>@MasterTypes.DisplayPlural(Model.Type)</h3>
            <p class="card-subtitle">@Model.Result.TotalCount record(s)</p>
        </div>
    </div>
    <div class="card-body border-bottom py-3">
        <form method="get" class="row g-2 align-items-end filter-row">
            <div class="col-md-4">
                <label class="form-label" for="search">Search</label>
                <div class="input-icon">
                    <span class="input-icon-addon"><i class="ti ti-search"></i></span>
                    <input id="search" name="search" value="@Model.Query.Search" class="form-control" placeholder="Code, name or description" />
                </div>
            </div>
            @if (parentType is { } pt)
            {
                <div class="col-md-3">
                    <label class="form-label" for="parentId">@MasterTypes.Display(pt)</label>
                    <select id="parentId" name="parentId" class="form-select">
                        <option value="">All</option>
                        @foreach (var p in Model.Parents)
                        {
                            <option value="@p.Id" selected="@(p.Id == Model.Query.ParentId)">@p.Name</option>
                        }
                    </select>
                </div>
            }
            <div class="col-md-2">
                <label class="form-label" for="isActive">Status</label>
                <select id="isActive" name="isActive" class="form-select">
                    <option value="">All</option>
                    <option value="true" selected="@(Model.Query.IsActive == true)">Active</option>
                    <option value="false" selected="@(Model.Query.IsActive == false)">Inactive</option>
                </select>
            </div>
            <div class="col-md-auto d-flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="ti ti-filter me-1"></i>Filter</button>
                <a asp-action="Index" asp-route-type="@Model.Type" class="btn btn-ghost-secondary">Reset</a>
            </div>
        </form>
    </div>
    @if (Model.Result.TotalCount == 0)
    {
        <div class="card-body"><partial name="_Empty" model="@(("ti-database-off", "No records found", "Try a different search or filter."))" /></div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table card-table table-vcenter">
                <thead>
                    <tr>
                        <th><partial name="_SortHeader" model="@(("Code", "code"))" /></th>
                        <th><partial name="_SortHeader" model="@(("Name", "name"))" /></th>
                        @if (parentType is { } pth)
                        {
                            <th><partial name="_SortHeader" model="@((MasterTypes.Display(pth), "parent"))" /></th>
                        }
                        <th>Description</th>
                        <th><partial name="_SortHeader" model="@(("Status", "isActive"))" /></th>
                        <th class="w-1"></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var item in Model.Result.Items)
                {
                    <tr>
                        <td><span class="badge bg-blue-lt font-monospace">@item.Code</span></td>
                        <td class="fw-medium">@item.Name</td>
                        @if (parentType != null) { <td class="text-secondary">@item.ParentName</td> }
                        <td class="text-secondary small">@item.Description</td>
                        <td><partial name="_ActiveBadge" model="item.IsActive" /></td>
                        <td class="text-nowrap">
                            <div class="btn-list flex-nowrap">
                                @if (Model.Type == MasterType.Variant)
                                {
                                    <a asp-controller="Assemblies" asp-action="Index" asp-route-variantId="@item.Id" class="btn btn-sm"><i class="ti ti-binary-tree-2 me-1"></i>Assemblies</a>
                                }
                                else
                                {
                                    var child = Model.Type + 1;
                                    <a asp-action="Index" asp-route-type="@child" asp-route-parentId="@item.Id" class="btn btn-sm">@MasterTypes.DisplayPlural(child) <i class="ti ti-chevron-right ms-1"></i></a>
                                }
                                @if (isAdmin)
                                {
                                    <a asp-action="Edit" asp-route-type="@Model.Type" asp-route-id="@item.Id" class="btn btn-sm btn-icon btn-ghost-primary" title="Edit" aria-label="Edit @item.Name"><i class="ti ti-edit"></i></a>
                                }
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
        <partial name="_Pager" model="PagerModel.From(Model.Result)" />
    }
</div>
