@model AssemblyFormViewModel
@{
    ViewData["Title"] = Model.Id.HasValue ? "Edit assembly" : "Add assembly";
    ViewData["Pretitle"] = "Assemblies";
}
<div class="row justify-content-center">
    <div class="col-lg-8 col-xl-7">
        <form method="post" class="card">
            <div class="card-body">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Item.VariantId" class="form-label required"></label>
                        <select asp-for="Item.VariantId" class="form-select">
                            <option value="">Select variant…</option>
                            @foreach (var v in Model.Variants)
                            {
                                <option value="@v.Id">@v.Name (@v.Code)</option>
                            }
                        </select>
                        <span asp-validation-for="Item.VariantId"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="Item.ParentId" class="form-label"></label>
                        <select asp-for="Item.ParentId" class="form-select"
                                data-cascade-parent="#Item_VariantId" data-cascade-url="@Url.Action("Assemblies", "Lookup")" data-cascade-param="variantId"
                                data-selected="@Model.Item.ParentId" data-placeholder="None (top-level assembly)">
                        </select>
                        <span asp-validation-for="Item.ParentId"></span>
                    </div>
                </div>
                <div class="alert alert-info py-2 small">
                    <div class="alert-icon"><i class="ti ti-info-circle"></i></div>
                    <div>Leave the parent empty for a top-level <strong>assembly</strong>. Pick an assembly to add a <strong>sub-assembly</strong>, or a sub-assembly to add a <strong>component</strong>.</div>
                </div>
                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label asp-for="Item.Code" class="form-label required"></label>
                        <input asp-for="Item.Code" class="form-control text-uppercase font-monospace" />
                        <span asp-validation-for="Item.Code"></span>
                    </div>
                    <div class="col-md-8 mb-3">
                        <label asp-for="Item.Name" class="form-label required"></label>
                        <input asp-for="Item.Name" class="form-control" />
                        <span asp-validation-for="Item.Name"></span>
                    </div>
                </div>
                <div class="mb-3">
                    <label asp-for="Item.Description" class="form-label"></label>
                    <textarea asp-for="Item.Description" class="form-control" rows="2"></textarea>
                </div>
                <label class="form-check form-switch">
                    <input asp-for="Item.IsActive" class="form-check-input" />
                    <span class="form-check-label">Active</span>
                </label>
            </div>
            <div class="card-footer text-end">
                <a asp-action="Index" asp-route-variantId="@Model.Item.VariantId" class="btn btn-link">Cancel</a>
                <button type="submit" class="btn btn-primary"><i class="ti ti-device-floppy me-1"></i>Save</button>
            </div>
        </form>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
