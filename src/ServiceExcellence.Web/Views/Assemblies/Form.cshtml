@model AssemblyFormViewModel
@{ ViewData["Title"] = Model.Id.HasValue ? "Edit assembly" : "Add assembly"; }
<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card">
            <div class="card-header">@ViewData["Title"]</div>
            <div class="card-body">
                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>
                    <div class="mb-3">
                        <label asp-for="Item.VariantId" class="form-label"></label>
                        <select asp-for="Item.VariantId" class="form-select">
                            <option value="">-- Select variant --</option>
                            @foreach (var v in Model.Variants)
                            {
                                <option value="@v.Id">@v.Text</option>
                            }
                        </select>
                        <span asp-validation-for="Item.VariantId"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Item.ParentId" class="form-label"></label>
                        <select asp-for="Item.ParentId" class="form-select"
                                data-cascade-parent="#Item_VariantId" data-cascade-url="@Url.Action("Assemblies", "Lookup")" data-cascade-param="variantId"
                                data-selected="@Model.Item.ParentId" data-placeholder="(none - top-level assembly)">
                        </select>
                        <div class="form-text">Leave empty for a top-level assembly. Choose an assembly to add a sub-assembly, or a sub-assembly to add a component.</div>
                        <span asp-validation-for="Item.ParentId"></span>
                    </div>
                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label asp-for="Item.Code" class="form-label"></label>
                            <input asp-for="Item.Code" class="form-control text-uppercase" />
                            <span asp-validation-for="Item.Code"></span>
                        </div>
                        <div class="col-md-8 mb-3">
                            <label asp-for="Item.Name" class="form-label"></label>
                            <input asp-for="Item.Name" class="form-control" />
                            <span asp-validation-for="Item.Name"></span>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Item.Description" class="form-label"></label>
                        <textarea asp-for="Item.Description" class="form-control" rows="2"></textarea>
                    </div>
                    <div class="form-check mb-4">
                        <input asp-for="Item.IsActive" class="form-check-input" />
                        <label asp-for="Item.IsActive" class="form-check-label"></label>
                    </div>
                    <button type="submit" class="btn btn-primary">Save</button>
                    <a asp-action="Index" asp-route-variantId="@Model.Item.VariantId" class="btn btn-link">Cancel</a>
                </form>
            </div>
        </div>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
