@model FinderViewModel
@{
    ViewData["Title"] = "SOP Finder";
    var selects = new ClassificationSelectsModel(string.Empty, Model.Divisions, Model.Query.DivisionId, Model.Query.CategoryId,
        Model.Query.ModelId, Model.Query.VariantId, Model.Query.AssemblyId, ColumnClass: "col-md-4 col-lg");
}
<div class="page-header">
    <div>
        <h1>SOP Finder</h1>
        <div class="text-muted small">Select the vehicle being serviced. You will see every published SOP that applies to it &ndash; including procedures defined for the whole division, category or model.</div>
    </div>
</div>

<form method="get" class="filter-bar">
    <div class="row g-2">
        <partial name="_ClassificationSelects" model="selects" />
    </div>
    <div class="row g-2 align-items-end">
        <div class="col-md-4">
            <label class="form-label small mb-1" for="activityType">Service activity</label>
            <select id="activityType" name="activityType" class="form-select">
                <option value="">All activities</option>
                @foreach (var (code, name) in ActivityTypes.All)
                {
                    <option value="@code" selected="@(code == Model.Query.ActivityType)">@name</option>
                }
            </select>
        </div>
        <div class="col-md-4">
            <label class="form-label small mb-1" for="search">Keyword</label>
            <input id="search" name="search" value="@Model.Query.Search" class="form-control" placeholder="e.g. brake, oil" />
        </div>
        <div class="col-md-4 d-flex gap-2">
            <button type="submit" class="btn btn-primary">Find SOPs</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Reset</a>
        </div>
    </div>
</form>

@if (Model.Result == null)
{
    <div class="card"><div class="card-body text-center text-muted py-5">Select at least a division to see applicable SOPs.</div></div>
}
else
{
    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th><partial name="_SortHeader" model="@(("SOP code", "code"))" /></th>
                        <th><partial name="_SortHeader" model="@(("Title", "title"))" /></th>
                        <th><partial name="_SortHeader" model="@(("Activity", "activity"))" /></th>
                        <th><partial name="_SortHeader" model="@(("Defined for", "appliesTo"))" /></th>
                        <th class="text-end"><partial name="_SortHeader" model="@(("Std. time", "time"))" /></th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var s in Model.Result.Items)
                {
                    <tr>
                        <td class="text-nowrap"><a asp-controller="Sops" asp-action="Details" asp-route-id="@s.Id" class="fw-semibold">@s.SopCode</a> <span class="text-muted small">v@(s.Version)</span></td>
                        <td>@s.Title</td>
                        <td class="small">@ActivityTypes.Display(s.ActivityType)</td>
                        <td class="small"><span class="badge bg-light text-dark border">@s.AppliesToLevel</span> @s.AppliesTo</td>
                        <td class="text-end small text-nowrap">@s.StandardTimeMinutes min</td>
                        <td class="text-end text-nowrap">
                            <a asp-controller="Sops" asp-action="Print" asp-route-id="@s.Id" target="_blank" class="btn btn-sm btn-outline-secondary">Print</a>
                            <a asp-controller="Sops" asp-action="Pdf" asp-route-id="@s.Id" class="btn btn-sm btn-outline-secondary">PDF</a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
    <partial name="_Pager" model="PagerModel.From(Model.Result)" />
}
